# Supabase Configuration
# Obtain your Project URL and Secret/Service-Role Key from:
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key

# Backwards compatibility: SUPABASE_SERVICE_KEY is also accepted if SUPABASE_SECRET_KEY is unset
# SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
